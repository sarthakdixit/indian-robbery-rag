# .env template for the Indian Robbery Law RAG Assistant.
#
# To use:
#   1. Copy this file to .env at the repo root: `cp backend/.env.example .env`
#   2. Fill in your real values
#   3. NEVER commit .env (it's in .gitignore)
#
# `pydantic-settings` reads .env automatically at backend startup. Same
# variables work for `make dev`, `make docker-run`, and `docker compose up`.
#
# Cloud deployment (Batch 7) sets these via Container Apps secrets pulling
# from Key Vault — the application code reads them identically.

# =====================================================================
# REQUIRED — backend will refuse to start without these
# =====================================================================

# Gemini API key from https://aistudio.google.com/apikey
# Free tier is plenty for local dev. The classifier and embedding paths
# use up to ~750 calls/day in heavy use.
GEMINI_API_KEY=your-gemini-key-here

# =====================================================================
# RECOMMENDED — defaults work for local but you should override
# =====================================================================

# Password for /api/admin/* endpoints. Required to be sent as the
# x-admin-password HTTP header on every admin call. NOT real auth —
# see backend/app/admin/auth.py for the threat model.
ADMIN_PASSWORD=local-dev-admin-changeme

# Salt for SHA-256 hashing of client IPs before they're logged. Anything
# random and >=16 chars is fine. Rotating this invalidates rate-limit
# counters (which is sometimes useful).
IP_HASH_SALT=local-dev-salt-change-me-please

# =====================================================================
# OPTIONAL — defaults are typically correct
# =====================================================================

# Runtime mode. `local` uses SQLite + stdout telemetry + always-valid
# Turnstile. `cloud` uses Cosmos + App Insights + real Cloudflare.
# Cloud mode requires additional config (see Batch 7).
ENVIRONMENT=local

# Where SQLite lives. Default is fine; override only for tests that
# want a throwaway path. Path is relative to the process CWD.
# SQLITE_PATH=local_data/app.db

# Turnstile keys (relevant only when ENVIRONMENT=cloud). The local
# adapter accepts all tokens, so these can stay unset for local dev.
# Get real keys from https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY=

# =====================================================================
# DOCKER-ONLY — read by entrypoint.sh, not by the application
# =====================================================================

# Override only if you need uvicorn on a non-default port inside the
# container. The host port is set in docker-compose.yml.
# PORT=8000

# Uvicorn worker count. >1 multiplies memory and causes ExactCache
# misses across processes (the cache is per-process). Stick with 1.
# UVICORN_WORKERS=1

# Uvicorn log level: debug, info, warning, error, critical.
# LOG_LEVEL=info