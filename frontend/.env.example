# Frontend env. Copy to .env.local for local dev.
# All vars must start with VITE_ to be exposed to the browser.

# Backend API base URL. In dev, Vite proxies /api/* through itself
# (see vite.config.ts), so the value here is what's used in
# production (Azure SWA Backend Linking handles this).
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile site key. The "1x..." key always passes —
# safe for local dev. Get a real key from:
# https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Environment flag. Used in a few places to switch behavior between
# local (relaxed) and cloud (strict). Match the backend's setting.
VITE_ENVIRONMENT=local
